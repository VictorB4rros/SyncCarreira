+/**
+ * @file api.ts
+ * @description Instância central do Axios do SyncCarreira.
+ *
+ *  - baseURL = raiz da API (VITE_API_URL), SEM prefixo /api/v1 — os controllers do
+ *    synccarreira-api são mapeados direto na raiz (/users, /students/me, /psychologist-panel...).
+ *  - Injeta `Authorization: Bearer <token>` em toda requisição.
+ *  - Normaliza TODO erro HTTP em `ApiError` (com `status`, `message`, `fieldErrors`),
+ *    preservando `response`/`config` para os services legados em JS que leem `err.response?.status`.
+ *  - Tratamento global:
+ *      401 → limpa sessão e redireciona para /login?reason=expired
+ *      403 → mensagem de permissão + evento global (para toast/banner)
+ *      409 → conflito de dados (duplicidade, estado concorrente)
+ *      422 → validação de campos (ValidationError.errors → fieldErrors) ou regra de negócio
+ *
+ * @example
+ * import api, { ApiError, getErrorMessage } from '@/services/api'
+ * try {
+ *   const { data } = await api.post<SchoolClassDTO>('/classes', payload)
+ * } catch (err) {
+ *   if (err instanceof ApiError && err.isValidation) setFieldErrors(err.fieldErrors)
+ *   else setError(getErrorMessage(err))
+ * }
+ */
+
+import axios, {
+  AxiosError,
+  type AxiosInstance,
+  type AxiosResponse,
+  type InternalAxiosRequestConfig,
+} from 'axios'
+import type { CustomError, OAuthErrorResponse, ValidationError } from '../types/api'
+
+// ─── Configuração ────────────────────────────────────────────────
+
+export const TOKEN_STORAGE_KEY = 'token'
+
+/** Raiz da API, sem barra final e sem /api/v1. */
+export const API_BASE_URL: string = (
+  (import.meta.env.VITE_API_URL as string | undefined) || 'http://localhost:8080'
+).replace(/\/+$/, '')
+
+/** Evento disparado em `window` para cada erro tratado globalmente (toasts, banners). */
+export const API_ERROR_EVENT = 'synccarreira:api-error'
+
+/** Opções extras aceitas por requisição. */
+declare module 'axios' {
+  interface AxiosRequestConfig {
+    /** Não redirecionar para /login em caso de 401 (ex.: checagem silenciosa de sessão). */
+    suppressAuthRedirect?: boolean
+    /** Não disparar o evento global de erro (a tela trata e exibe sozinha). */
+    suppressGlobalError?: boolean
+  }
+}
+
+// ─── Mensagens padrão ────────────────────────────────────────────
+
+const DEFAULT_MESSAGES: Record<number, string> = {
+  400: 'Requisição inválida. Revise os dados enviados.',
+  401: 'Sua sessão expirou. Faça login novamente.',
+  403: 'Você não tem permissão para acessar este recurso.',
+  404: 'Recurso não encontrado.',
+  409: 'Conflito: os dados já existem ou foram alterados por outra operação.',
+  422: 'Alguns campos estão inválidos. Revise e tente novamente.',
+  500: 'Erro interno no servidor. Tente novamente em instantes.',
+}
+
+const NETWORK_MESSAGE = 'Não foi possível conectar ao servidor. Verifique sua conexão.'
+const TIMEOUT_MESSAGE = 'O servidor demorou para responder. Tente novamente.'
+
+// ─── ApiError ────────────────────────────────────────────────────
+
+export type ApiErrorKind =
+  | 'network'
+  | 'timeout'
+  | 'unauthorized'
+  | 'forbidden'
+  | 'not_found'
+  | 'conflict'
+  | 'validation'
+  | 'business'
+  | 'bad_request'
+  | 'server'
+  | 'unknown'
+
+/**
+ * Erro normalizado de qualquer chamada HTTP.
+ * Mantém `response` e `config` do Axios por compatibilidade com o código legado.
+ */
+export class ApiError extends Error {
+  readonly status: number | null
+  readonly kind: ApiErrorKind
+  /** Erros por campo (somente 422 de Bean Validation). */
+  readonly fieldErrors: Record<string, string>
+  readonly path: string | null
+  readonly body: unknown
+  readonly response?: AxiosResponse
+  readonly config?: InternalAxiosRequestConfig
+  readonly isApiError = true as const
+
+  constructor(params: {
+    message: string
+    status: number | null
+    kind: ApiErrorKind
+    fieldErrors?: Record<string, string>
+    path?: string | null
+    body?: unknown
+    response?: AxiosResponse
+    config?: InternalAxiosRequestConfig
+  }) {
+    super(params.message)
+    this.name = 'ApiError'
+    this.status = params.status
+    this.kind = params.kind
+    this.fieldErrors = params.fieldErrors ?? {}
+    this.path = params.path ?? null
+    this.body = params.body
+    this.response = params.response
+    this.config = params.config
+  }
+
+  get isValidation(): boolean {
+    return this.kind === 'validation'
+  }
+
+  get isConflict(): boolean {
+    return this.kind === 'conflict'
+  }
+
+  get isForbidden(): boolean {
+    return this.kind === 'forbidden'
+  }
+
+  get isUnauthorized(): boolean {
+    return this.kind === 'unauthorized'
+  }
+
+  get isNetwork(): boolean {
+    return this.kind === 'network' || this.kind === 'timeout'
+  }
+}
+
+export function isApiError(err: unknown): err is ApiError {
+  return err instanceof ApiError
+}
+
+/** Mensagem pronta para exibir ao usuário, para qualquer erro. */
+export function getErrorMessage(err: unknown, fallback = 'Ocorreu um erro inesperado.'): string {
+  if (err instanceof ApiError) return err.message
+  if (err instanceof Error && err.message) return err.message
+  return fallback
+}
+
+/** Erros por campo (vazio se não for 422 de validação). */
+export function getFieldErrors(err: unknown): Record<string, string> {
+  return err instanceof ApiError ? err.fieldErrors : {}
+}
+
+// ─── Helpers internos ────────────────────────────────────────────
+
+function isValidationBody(body: unknown): body is ValidationError {
+  return (
+    typeof body === 'object' &&
+    body !== null &&
+    Array.isArray((body as ValidationError).errors)
+  )
+}
+
+function isCustomErrorBody(body: unknown): body is CustomError {
+  return typeof body === 'object' && body !== null && typeof (body as CustomError).error === 'string'
+}
+
+function isOAuthErrorBody(body: unknown): body is OAuthErrorResponse {
+  return (
+    typeof body === 'object' &&
+    body !== null &&
+    typeof (body as OAuthErrorResponse).error_description === 'string'
+  )
+}
+
+/** Downloads (.xlsx/.pdf) usam responseType 'blob': o corpo do erro chega como Blob JSON. */
+async function readBody(data: unknown): Promise<unknown> {
+  if (typeof Blob !== 'undefined' && data instanceof Blob) {
+    try {
+      const text = await data.text()
+      return text ? JSON.parse(text) : null
+    } catch {
+      return null
+    }
+  }
+  return data
+}
+
+function kindFromStatus(status: number, body: unknown): ApiErrorKind {
+  if (status === 401) return 'unauthorized'
+  if (status === 403) return 'forbidden'
+  if (status === 404) return 'not_found'
+  if (status === 409) return 'conflict'
+  if (status === 422) return isValidationBody(body) ? 'validation' : 'business'
+  if (status === 400) return 'bad_request'
+  if (status >= 500) return 'server'
+  return 'unknown'
+}
+
+function messageFrom(status: number, kind: ApiErrorKind, body: unknown): string {
+  // 422 de Bean Validation: "Dados inválidos" é genérico; a mensagem útil está nos campos
+  if (kind === 'validation') {
+    const first = (body as ValidationError).errors[0]
+    return first ? `${DEFAULT_MESSAGES[422]} (${first.message})` : DEFAULT_MESSAGES[422]
+  }
+  // 5xx: não expor detalhes internos
+  if (kind === 'server') return DEFAULT_MESSAGES[500]
+
+  if (isCustomErrorBody(body) && body.error.trim()) return body.error
+  if (isOAuthErrorBody(body)) return body.error_description as string
+  return DEFAULT_MESSAGES[status] ?? `Erro inesperado (HTTP ${status}).`
+}
+
+function emitGlobalError(error: ApiError): void {
+  if (typeof window === 'undefined' || error.config?.suppressGlobalError) return
+  window.dispatchEvent(new CustomEvent<ApiError>(API_ERROR_EVENT, { detail: error }))
+}
+
+// Evita vários redirecionamentos quando requisições paralelas recebem 401 ao mesmo tempo
+let redirectingToLogin = false
+
+function handleUnauthorized(config?: InternalAxiosRequestConfig): void {
+  localStorage.removeItem(TOKEN_STORAGE_KEY)
+  if (config?.suppressAuthRedirect || redirectingToLogin) return
+  if (window.location.pathname.startsWith('/login')) return
+
+  redirectingToLogin = true
+  const from = encodeURIComponent(window.location.pathname + window.location.search)
+  // window.location (e não navigate) de propósito: zera o estado do AuthContext
+  window.location.replace(`/login?reason=expired&from=${from}`)
+}
+
+async function normalizeError(error: AxiosError): Promise<ApiError> {
+  const config = error.config
+
+  // Sem resposta: rede caída, CORS, backend fora do ar ou timeout
+  if (!error.response) {
+    const isTimeout = error.code === AxiosError.ECONNABORTED || error.code === AxiosError.ETIMEDOUT
+    return new ApiError({
+      message: isTimeout ? TIMEOUT_MESSAGE : NETWORK_MESSAGE,
+      status: null,
+      kind: isTimeout ? 'timeout' : 'network',
+      config,
+    })
+  }
+
+  const { status } = error.response
+  const body = await readBody(error.response.data)
+  const kind = kindFromStatus(status, body)
+
+  const fieldErrors: Record<string, string> = {}
+  if (isValidationBody(body)) {
+    for (const { fieldName, message } of body.errors) fieldErrors[fieldName] = message
+  }
+
+  return new ApiError({
+    message: messageFrom(status, kind, body),
+    status,
+    kind,
+    fieldErrors,
+    path: isCustomErrorBody(body) ? body.path : config?.url ?? null,
+    body,
+    response: error.response,
+    config,
+  })
+}
+
+// ─── Instância ───────────────────────────────────────────────────
+
+const api: AxiosInstance = axios.create({
+  baseURL: API_BASE_URL,
+  timeout: 15000,
+  headers: { 'Content-Type': 'application/json' },
+})
+
+api.interceptors.request.use((config) => {
+  const token = localStorage.getItem(TOKEN_STORAGE_KEY)
+  if (token) config.headers.set('Authorization', `Bearer ${token}`)
+  return config
+})
+
+api.interceptors.response.use(
+  (response) => response,
+  async (error: unknown) => {
+    // Requisição cancelada pela própria tela (AbortController): não é erro de verdade
+    if (axios.isCancel(error)) return Promise.reject(error)
+    if (!axios.isAxiosError(error)) return Promise.reject(error)
+
+    const apiError = await normalizeError(error)
+
+    switch (apiError.kind) {
+      case 'unauthorized':
+        handleUnauthorized(apiError.config)
+        break
+      case 'forbidden':
+        console.warn('[API] 403 — permissão insuficiente:', apiError.path)
+        emitGlobalError(apiError)
+        break
+      case 'conflict':
+      case 'server':
+      case 'network':
+      case 'timeout':
+        emitGlobalError(apiError)
+        break
+      case 'validation':
+      case 'business':
+        // 422: a própria tela exibe (fieldErrors nos inputs / mensagem no formulário)
+        break
+      default:
+        break
+    }
+
+    if (apiError.kind === 'server') console.error('[API] Erro no servidor:', apiError.body)
+
+    return Promise.reject(apiError)
+  },
+)
+
+export default api
