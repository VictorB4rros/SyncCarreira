+}
+
+function JourneyPill({ shell }: { shell: ShellState }) {
+  if (shell.status === 'loading') {
+    return <span className="hidden md:block h-6 w-44 rounded-full bg-[#fde7ff] animate-pulse" aria-label="Carregando jornada" />
