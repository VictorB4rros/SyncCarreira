+
+  if (connected) {
+    return (
+      <div className="hidden md:flex bg-[#ECFDF5] text-[#059669] border border-emerald-200 px-3 py-1.5 rounded-full text-xs font-semibold items-center gap-2 whitespace-nowrap">
