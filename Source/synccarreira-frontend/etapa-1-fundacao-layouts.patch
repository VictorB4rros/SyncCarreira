+        <div className="flex items-center gap-3 flex-1 min-w-0">
+          <button
+            type="button"
+            onClick={() => setMobileOpen(true)}
+            className="lg:hidden p-2 -ml-1 rounded-lg text-slate-600 hover:bg-slate-100"
+            aria-label="Abrir menu"
