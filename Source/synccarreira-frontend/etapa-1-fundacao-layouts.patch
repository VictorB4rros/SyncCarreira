+function NextSessionCard({ shell, onRetry }: { shell: ShellState; onRetry: () => void }) {
+  const base =
+    'hidden lg:flex items-center gap-1 px-2 py-1.5 rounded-xl bg-[#ffefff] text-[#320047] shadow-[0_2px_8px_-2px_rgba(91,44,111,0.05)]'
